# PostgreSQL connection string (used by the app and Drizzle).
# Example for local Postgres: postgres://user:password@localhost:5432/agency_docs
# For Neon, use the connection string from your project dashboard.
DATABASE_URL=

# Neon Auth server URL from the Neon Console.
NEON_AUTH_BASE_URL=

# Secret used to sign Neon Auth cookies. Generate with:
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
